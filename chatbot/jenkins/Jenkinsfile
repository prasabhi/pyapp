pipeline {
    agent any

    stages {

        stage('Build Docker Image') {
            steps {
                sh '''
                  docker build \
                  -t chatbot-app \
                  -f chatbot/docker/Dockerfile \
                  .
                '''
            }
        }

        stage('Run Containers') {
            steps {
                sh '''
                  cd chatbot
                  pwd
                  ls -l
                  ls -l monitoring
                  docker compose up
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully'
        }
        failure {
            echo 'Pipeline failed'
        }
    }
}
