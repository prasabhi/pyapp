pipeline {
    agent any

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                  docker build \
                  -t chatbot-app \
                  -f chatbot/docker/Dockerfile \
                  .
                '''
            }
        }

        stage('Run Containers') {
            steps {
                dir('chatbot') {
                    sh '''
                      docker compose down -v || true
                      docker compose up -d
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully'
        }
        failure {
            echo 'Pipeline failed'
            sh '''
              docker compose logs prometheus || true
            '''
        }
    }
}
